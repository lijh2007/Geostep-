<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- 仅 debug：广告自动化入口，release 不包含。 -->
        <receiver
            android:name=".DebugAutomationReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.geostep.app.DEBUG_INJECT" />
                <action android:name="com.geostep.app.DEBUG_START" />
                <action android:name="com.geostep.app.DEBUG_STOP" />
                <action android:name="com.geostep.app.DEBUG_STATUS" />
                <action android:name="com.geostep.app.DEBUG_EXEC" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
